# ─────────────────────────────────────────────────────────────────────────────
#  Build output
# ─────────────────────────────────────────────────────────────────────────────
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates

# ─────────────────────────────────────────────────────────────────────────────
#  IDE
# ─────────────────────────────────────────────────────────────────────────────
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# ─────────────────────────────────────────────────────────────────────────────
#  Node / web clients
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
.turbo/
coverage/

# VitePress docs site build output and cache. The markdown in docs/ is the
# source of truth; the rendered site is produced by CI.
docs/.vitepress/dist/
docs/.vitepress/cache/

# ─────────────────────────────────────────────────────────────────────────────
#  Secrets — NEVER commit any of these
#
#  The fiscal RSA private key is the single most sensitive artefact in this
#  repository's blast radius. It is registered with AT and signs legally binding
#  documents. It belongs in a secret store, never in git, never in an image.
#  See docs/fiscal/key-management.md
# ─────────────────────────────────────────────────────────────────────────────
*.pfx
*.p12
*.pem
*.key
!**/testdata/**/*.pem
!**/Fixtures/**/*.pem
appsettings.Local.json
appsettings.*.Local.json
.env
.env.*
!.env.example
secrets.json

# ─────────────────────────────────────────────────────────────────────────────
#  Local data / runtime
# ─────────────────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
siteagent-data/
pgdata/
logs/
*.log

# ─────────────────────────────────────────────────────────────────────────────
#  OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
#  Local machine automation — not part of this project, never committed.
#  A Windows Scheduled Task poller that resumes a paused Claude Code session;
#  see the task itself ("ClaudeCodeAutoResume-BrasaPOS") for what it does.
# ─────────────────────────────────────────────────────────────────────────────
.claude-autopilot/
