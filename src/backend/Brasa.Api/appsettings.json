{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "//": "Postgres (brasa_app, unprivileged) is what the app connects as at runtime, so RLS actually applies — see docs/architecture/multi-tenancy.md. PostgresMigrations (brasa, superuser) runs DDL only.",
    "Postgres": "Host=localhost;Port=5432;Database=brasa;Username=brasa_app;Password=devonly_app",
    "PostgresMigrations": "Host=localhost;Port=5432;Database=brasa;Username=brasa;Password=devonly"
  },
  "AllowedHosts": "*"
}
