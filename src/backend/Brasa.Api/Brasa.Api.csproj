<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>brasa-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="ExcelDataReader" />
    <!-- NU1510 (package pruning) flags this as redundant with the shared
         framework's reference assembly, but the runtime provider it
         registers (ExcelImportParser's static constructor) isn't present
         at runtime without the real package — genuinely needed, not a
         stale reference. -->
    <PackageReference Include="System.Text.Encoding.CodePages" NoWarn="NU1510" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- Beta-only (ADR 0012) — Database:Provider=InMemory swaps Hangfire's storage to this. -->
    <PackageReference Include="Hangfire.InMemory" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brasa.Shared\Brasa.Shared.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Identity\Brasa.Modules.Identity.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Catalog\Brasa.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Ordering\Brasa.Modules.Ordering.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Floor\Brasa.Modules.Floor.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Fiscal\Brasa.Modules.Fiscal.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Payments\Brasa.Modules.Payments.csproj" />
    <ProjectReference Include="..\Brasa.Modules.Reporting\Brasa.Modules.Reporting.csproj" />
    <ProjectReference Include="..\Brasa.Fiscal.Mock\Brasa.Fiscal.Mock.csproj" />
    <ProjectReference Include="..\Brasa.Fiscal.Portugal\Brasa.Fiscal.Portugal.csproj" />
  </ItemGroup>

</Project>
