<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Brasa.Fiscal.Portugal</RootNamespace>
  </PropertyGroup>

  <!--
    Portuguese fiscalisation: ATCUD, RSA signature chain, AT QR code, SAF-T (PT),
    and the AT webservice clients for series registration and monthly submission.

    This assembly is the subject of AT certification (Portaria 363/2010).
    Changes here require re-running the golden-file suite and, for behavioural
    changes, notifying AT. See docs/fiscal/README.md before editing.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brasa.Modules.Fiscal\Brasa.Modules.Fiscal.csproj" />
    <ProjectReference Include="..\Brasa.Shared\Brasa.Shared.csproj" />
  </ItemGroup>

</Project>
