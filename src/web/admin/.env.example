# Copy to .env.development.local to override — see src/api/client.ts.
# Defaults to the API's "http" launch profile (Properties/launchSettings.json).
VITE_API_BASE_URL=http://localhost:5216/api/v1

# Sentry DSN (OPS-14) — see src/lib/errorReporting.ts. Empty/unset here on
# purpose: no real Sentry project exists yet (OPS-11's "no infra
# credentials" gap), so Sentry.init() runs with no dsn and never sends
# anything anywhere. Set this in production once a project does.
VITE_SENTRY_DSN=
